rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Users can create their own account document and choose a role once.
      allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.role in ['customer', 'provider'];

      // Roles are deliberately immutable after creation.
      allow update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.role == resource.data.role;

      allow get: if request.auth != null
          && (request.auth.uid == userId
              || (resource.data.role == 'provider'
                  && resource.data.verificationStatus == 'verified'));

      // Provider discovery queries must only return verified provider accounts.
      allow list: if request.auth != null
          && resource.data.role == 'provider'
          && resource.data.verificationStatus == 'verified';
    }

    match /bookings/{bookingId} {
      // A signed-in customer can create only their own pending request for a
      // verified provider.
      allow create: if request.auth != null
          && request.resource.data.customerId == request.auth.uid
          && request.resource.data.status == 'pending'
          && get(/databases/$(database)/documents/users/$(request.resource.data.providerId)).data.role == 'provider'
          && get(/databases/$(database)/documents/users/$(request.resource.data.providerId)).data.verificationStatus == 'verified';

      // A booking transaction first reads the deterministic slot document.
      // Let signed-in users read a missing slot so a new booking can be
      // created, but keep existing bookings private to their participants.
      allow get: if request.auth != null
          && (!exists(/databases/$(database)/documents/bookings/$(bookingId))
              || resource.data.customerId == request.auth.uid
              || resource.data.providerId == request.auth.uid);

      // Provider dashboard queries are constrained by providerId.
      allow list: if request.auth != null
          && (resource.data.customerId == request.auth.uid
              || resource.data.providerId == request.auth.uid);

      // Only the assigned provider can accept or decline, without changing
      // ownership or booking details.
      allow update: if request.auth != null
          && resource.data.providerId == request.auth.uid
          && request.resource.data.providerId == resource.data.providerId
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.status in ['accepted', 'declined'];

      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow get, list: if request.auth != null
          && request.auth.uid in resource.data.participantIds;

      allow create: if request.auth != null
          && request.auth.uid in request.resource.data.participantIds
          && request.resource.data.participantIds.size() == 2
          && request.resource.data.participantNames.keys().hasAll(request.resource.data.participantIds)
          && request.resource.data.participantRoles.keys().hasAll(request.resource.data.participantIds)
          && request.resource.data.unreadCount.keys().hasAll(request.resource.data.participantIds);

      // Participants can update only the conversation preview and unread
      // counters. The participant list and identities are immutable.
      allow update: if request.auth != null
          && request.auth.uid in resource.data.participantIds
          && request.resource.data.participantIds == resource.data.participantIds
          && request.resource.data.participantNames == resource.data.participantNames
          && request.resource.data.participantRoles == resource.data.participantRoles
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['lastMessage', 'lastMessageAt', 'lastMessageSenderId', 'unreadCount']);

      allow delete: if false;

      match /messages/{messageId} {
        allow get, list: if request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;

        allow create: if request.auth != null
            && request.resource.data.senderId == request.auth.uid
            && request.resource.data.keys().hasOnly(['senderId', 'text', 'sentAt'])
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;

        allow update, delete: if false;
      }
    }
  }
}
