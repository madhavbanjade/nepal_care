rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }
    function hasVerificationStatus(data) {
      return data.keys().hasAll(['verificationStatus']);
    }
    function hasRole(data) {
      return data.keys().hasAll(['role']);
    }
    // A provider may only create a pending status, never verified.
    function validCreateStatus() {
      return !hasVerificationStatus(request.resource.data) ||
          request.resource.data.verificationStatus == 'pending';
    }
    // A provider may add pending status once, but cannot alter it afterward.
    function validProviderStatusUpdate() {
      return (!hasVerificationStatus(resource.data) &&
              !hasVerificationStatus(request.resource.data)) ||
          (!hasVerificationStatus(resource.data) &&
              hasVerificationStatus(request.resource.data) &&
              request.resource.data.verificationStatus == 'pending') ||
          (hasVerificationStatus(resource.data) &&
              hasVerificationStatus(request.resource.data) &&
              request.resource.data.verificationStatus ==
                  resource.data.verificationStatus);
    }
    // Role can be set once, then is immutable.
    function validRoleCreate() {
      return hasRole(request.resource.data) &&
          request.resource.data.role in ['customer', 'provider'];
    }
    function validRoleUpdate() {
      return (!hasRole(resource.data) &&
              hasRole(request.resource.data) &&
              request.resource.data.role in ['customer', 'provider']) ||
          (hasRole(resource.data) &&
              hasRole(request.resource.data) &&
              request.resource.data.role == resource.data.role);
    }
    match /users/{userId} {
      // Used by verified-provider dashboard queries.
      allow list: if signedIn() &&
          resource.data.verificationStatus == 'verified';
      allow get: if signedIn() &&
          (request.auth.uid == userId ||
              resource.data.verificationStatus == 'verified');
      // A user can create only their own document and choose role once.
      allow create: if isOwner(userId) &&
          validRoleCreate() &&
          validCreateStatus();
      // Users may update only their document; role and verification status
      // cannot be elevated or changed by the client.
      allow update: if isOwner(userId) &&
          validRoleUpdate() &&
          validProviderStatusUpdate();
      allow delete: if false;
    }
    match /bookings/{bookingId} {
      // Customers may make a pending booking only for themselves and only
      // against a verified provider.
      allow create: if signedIn() &&
          request.resource.data.customerId == request.auth.uid &&
          request.resource.data.status == 'pending' &&
          get(/databases/$(database)/documents/users/$(request.resource.data.providerId))
              .data.role == 'provider' &&
          get(/databases/$(database)/documents/users/$(request.resource.data.providerId))
              .data.verificationStatus == 'verified';
      // Split from `list` on purpose: createBooking() runs a transaction.get()
      // on a doc that may not exist yet (the double-booking check), and for a
      // nonexistent doc `resource` is null — so `get` must tolerate that
      // before touching resource.data. `list` never targets a nonexistent
      // doc, so it doesn't need the same allowance.
      allow get: if signedIn() &&
          (resource == null ||
              resource.data.customerId == request.auth.uid ||
              resource.data.providerId == request.auth.uid);
      // A booking is visible in list queries only to its customer and
      // assigned provider.
      allow list: if signedIn() &&
          (resource.data.customerId == request.auth.uid ||
              resource.data.providerId == request.auth.uid);
      // Only the assigned provider may accept or decline a request.
      allow update: if signedIn() &&
          resource.data.providerId == request.auth.uid &&
          request.resource.data.providerId == resource.data.providerId &&
          request.resource.data.customerId == resource.data.customerId &&
          request.resource.data.status in ['accepted', 'declined'];
      // The customer who made the booking may cancel it, as long as it's
      // still pending or accepted (not already resolved) and nothing else
      // about the booking changes in the same write.
      allow update: if signedIn() &&
          resource.data.customerId == request.auth.uid &&
          resource.data.status in ['pending', 'accepted'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
          request.resource.data.status == 'cancelled';
      allow delete: if false;
    }

    // ── Chat: conversations + messages ──────────────────────────────────
    function isParticipant(data) {
      return signedIn() && request.auth.uid in data.participantIds;
    }
    // Only the two people already on a conversation can create it, and it
    // must be exactly a 1:1 thread with the sender/recipient name+role maps
    // keyed to those same two ids.
    function validConversationCreate() {
      let data = request.resource.data;
      return data.participantIds.size() == 2 &&
          request.auth.uid in data.participantIds &&
          data.participantNames.keys().hasAll(data.participantIds) &&
          data.participantRoles.keys().hasAll(data.participantIds) &&
          data.lastMessageSenderId == '';
    }
    // A conversation update may only touch the preview/unread fields —
    // never re-point it at different participants or rewrite history.
    function validConversationUpdate() {
      let unchangedKeys = ['participantIds', 'participantNames', 'participantRoles'];
      return isParticipant(resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['lastMessage', 'lastMessageAt', 'lastMessageSenderId', 'unreadCount']) &&
          request.resource.data.participantIds == resource.data.participantIds &&
          request.resource.data.participantNames == resource.data.participantNames &&
          request.resource.data.participantRoles == resource.data.participantRoles &&
          (!('lastMessageSenderId' in request.resource.data.diff(resource.data).affectedKeys())
              || request.resource.data.lastMessageSenderId == request.auth.uid
              || request.resource.data.lastMessageSenderId == '');
    }

    match /conversations/{conversationId} {
      allow get: if isParticipant(resource.data);
      // Matches the arrayContains(currentUserId) query in ChatRepository.
      allow list: if isParticipant(resource.data);
      allow create: if validConversationCreate();
      allow update: if validConversationUpdate();
      allow delete: if false;

      match /messages/{messageId} {
        // A message is only visible to the two people on its parent
        // conversation — checked via the parent doc, since messages don't
        // carry participantIds themselves.
        allow read: if isParticipant(
            get(/databases/$(database)/documents/conversations/$(conversationId)).data);
        // Senders can only post as themselves, and only into a conversation
        // they're actually part of.
        allow create: if signedIn() &&
            request.resource.data.senderId == request.auth.uid &&
            isParticipant(
                get(/databases/$(database)/documents/conversations/$(conversationId)).data);
        // Messages are immutable once sent — no edits, no deletes.
        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
